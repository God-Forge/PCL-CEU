<Window x:Class="PCL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plain Craft Launcher (PCL) CEU 修改版" Height="680" Width="1080"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ColorBrush8}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D6E4F5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3A50" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#20242B">
            <StackPanel Margin="16,28,16,16">
                <TextBlock Text="PCL CEU" Foreground="White" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="C# / .NET 8" Foreground="#8FA3B8" FontSize="12" Margin="0,4,0,24" />
                <Button x:Name="NavHome" Style="{StaticResource NavButton}" Content="启动" Height="40" Margin="0,0,0,8" Click="NavHome_Click" />
                <Button x:Name="NavDownload" Style="{StaticResource NavButton}" Content="下载" Height="40" Margin="0,0,0,8" Click="NavDownload_Click" />
                <Button x:Name="NavInstance" Style="{StaticResource NavButton}" Content="实例" Height="40" Margin="0,0,0,8" Click="NavInstance_Click" />
                <Button x:Name="NavTools" Style="{StaticResource NavButton}" Content="百宝箱" Height="40" Margin="0,0,0,8" Click="NavTools_Click" />
                <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="设置" Height="40" Margin="0,0,0,8" Click="NavSettings_Click" />
                <Button x:Name="NavPages" Style="{StaticResource NavButton}" Content="全部页面" Height="40" Margin="0,0,0,8" Click="NavPages_Click" />
                <Button x:Name="NavHelp" Style="{StaticResource NavButton}" Content="帮助" Height="40" Margin="0,0,0,8" Click="NavHelp_Click" />
                <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Content="关于" Height="40" Margin="0,0,0,8" Click="NavAbout_Click" />
                <TextBlock x:Name="VersionText" Foreground="#8FA3B8" FontSize="12" Margin="0,24,0,0" TextWrapping="Wrap" />
                <Border x:Name="PanMusic" Margin="0,14,0,0" Padding="8,6" CornerRadius="6"
                        Background="#2A3A50" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="MusicTitle" Foreground="#D6E4F5" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnMusicToggle" Content="播放" FontSize="11" Padding="8,2" Width="56" />
                            <Button x:Name="BtnMusicNext" Content="下一首" FontSize="11" Padding="8,2" Width="60" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="PanBackground" Grid.Column="1" Margin="24" Visibility="Collapsed"
                IsHitTestVisible="False" Panel.ZIndex="-1" />

        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="24" />

        <StackPanel x:Name="PanHint" Grid.ColumnSpan="2" Panel.ZIndex="10"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="0,0,0,16" IsHitTestVisible="False" />
    </Grid>
</Window>




