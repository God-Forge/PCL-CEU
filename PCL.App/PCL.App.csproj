<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <StartupObject>PCL.App.Program</StartupObject>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>PCL</AssemblyName>
        <RootNamespace>PCL.App</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Version>0.24.0</Version>
        <AssemblyVersion>0.24.0.0</AssemblyVersion>
        <FileVersion>0.24.0.0</FileVersion>
        <LangVersion>13.0</LangVersion>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    </ItemGroup>

</Project>


























