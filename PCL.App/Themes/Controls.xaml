<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PCL.App.Controls">

    <!--
        控件样式（v1.0.3 起改用 Tokens.xaml 的语义令牌）。
        旧颜色的键仍然存在，因此尚未迁移的页面不受影响。
    -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 按钮：补 Focus 态，圆角与内边距改用令牌 -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Button}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Hover}" />
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfacePressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <!-- 键盘可达性：焦点态用强调色描边，不改边框宽度以免内容位移 -->
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:MyButton}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="30" />
        <Style.Triggers>
            <Trigger Property="ColorType" Value="Highlight">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            </Trigger>
            <Trigger Property="ColorType" Value="Red">
                <Setter Property="Background" Value="{DynamicResource ColorBrushRedLight}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:MyTextButton}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
    </Style>

    <Style TargetType="{x:Type local:MyIconButton}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="{DynamicResource Space.XS}" />
    </Style>

    <Style TargetType="{x:Type local:MyIconTextButton}" BasedOn="{StaticResource {x:Type Button}}" />

    <Style TargetType="{x:Type local:MyListItem}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="Checked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorBrush6}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush5}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 卡片：阴影改用层级令牌 -->
    <Style TargetType="{x:Type local:MyCard}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="Margin" Value="0,0,0,15" />
        <Setter Property="Effect" Value="{DynamicResource Elevation.1}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{DynamicResource Elevation.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 输入框：补 Hover 与 Focus 态 -->
    <Style TargetType="{x:Type local:MyTextBox}">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MyTextBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Input}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:MySearchBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="{DynamicResource Padding.Input}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>

    <Style TargetType="{x:Type local:MyComboBox}">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>

    <Style TargetType="{x:Type local:MyPageRight}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    </Style>

    <Style TargetType="{x:Type local:MyPageLeft}">
        <Setter Property="Background" Value="{DynamicResource ColorBrushBackgroundTransparentSidebar}" />
    </Style>

    <Style TargetType="{x:Type local:MyHint}">
        <Setter Property="Background" Value="{DynamicResource ColorBrush6}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush5}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Hint}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="{x:Type local:MyLoading}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Body}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- 复选框与单选框：只补基础态与交互态，不重写模板 -->
    <Style TargetType="{x:Type local:MyCheckBox}">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- MyRadioBox 与 MyRadioButton 是兄弟类型，不能互相 BasedOn；
         直接定义在 RadioButton 基类上，两个子类都会自动继承 -->
    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

</ResourceDictionary>
