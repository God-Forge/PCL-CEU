<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PCL.App.Controls">

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
                <Setter Property="Background" Value="{DynamicResource ColorBrush8}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorBrush6}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:MyButton}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="30" />
        <Style.Triggers>
            <Trigger Property="ColorType" Value="Highlight">
                <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="ColorType" Value="Red">
                <Setter Property="Background" Value="{DynamicResource ColorBrushRedLight}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushRedDark}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:MyTextButton}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    </Style>

    <Style TargetType="{x:Type local:MyIconButton}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="{x:Type local:MyIconTextButton}" BasedOn="{StaticResource {x:Type Button}}" />

    <Style TargetType="{x:Type local:MyListItem}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="Checked" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorBrush6}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush5}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:MyCard}">
        <Setter Property="Background" Value="#F5FFFFFF" />
        <Setter Property="Margin" Value="0,0,0,15" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="8" ShadowDepth="1" Opacity="0.07" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="{DynamicResource ColorObject4}" BlurRadius="10" ShadowDepth="1" Opacity="0.35" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:MyTextBox}">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MyTextBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:MySearchBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
    </Style>

    <Style TargetType="{x:Type local:MyComboBox}">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
    </Style>

    <Style TargetType="{x:Type local:MyPageRight}">
        <Setter Property="Background" Value="{DynamicResource ColorBrush8}" />
    </Style>

    <Style TargetType="{x:Type local:MyPageLeft}">
        <Setter Property="Background" Value="{DynamicResource ColorBrushBackgroundTransparentSidebar}" />
    </Style>

    <Style TargetType="{x:Type local:MyHint}">
        <Setter Property="Background" Value="{DynamicResource ColorBrush6}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush5}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style TargetType="{x:Type local:MyLoading}">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray2}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

</ResourceDictionary>



