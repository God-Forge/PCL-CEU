<UserControl x:Class="PCL.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="启动" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="刷新实例" Width="100" Height="32" Margin="20,0,0,0" Click="Refresh_Click" />
            <Button Content="启动游戏" Width="110" Height="32" Margin="10,0,0,0" Click="Launch_Click" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <ListBox x:Name="InstanceList" FontSize="14" Background="Transparent" BorderThickness="0" />
            <Border x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ColorBrush6}" CornerRadius="8" Padding="34,28" MaxWidth="560">
                <StackPanel>
                    <TextBlock Text="还没有 Minecraft 实例" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Center" />
                    <TextBlock Text="请把实例放入当前数据目录，或从“下载”页安装一个版本。" Margin="0,10,0,0"
                               Foreground="{DynamicResource ColorBrushGray1}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="打开数据目录" Width="130" Height="34" Margin="0,18,0,0" HorizontalAlignment="Center" Click="OpenData_Click" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#667" Text="正在读取实例……" />
    </Grid>
</UserControl>



