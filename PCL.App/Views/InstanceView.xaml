<UserControl x:Class="PCL.App.Views.InstanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="实例" FontSize="26" FontWeight="Bold" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,10">
            <ComboBox x:Name="InstanceBox" Width="300" Height="32" />
            <Button Content="刷新" Width="80" Height="32" Margin="12,0,0,0" Click="Refresh_Click" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="TabOverall" Content="概览" Width="96" Height="32" Click="TabOverall_Click" />
            <Button x:Name="TabSetup" Content="版本设置" Width="96" Height="32" Margin="8,0,0,0" Click="TabSetup_Click" />
            <Button x:Name="TabMod" Content="Mod 管理" Width="96" Height="32" Margin="8,0,0,0" Click="TabMod_Click" />
            <Button x:Name="TabExport" Content="导出" Width="96" Height="32" Margin="8,0,0,0" Click="TabExport_Click" />
        </StackPanel>
        <ContentControl x:Name="PageHost" Grid.Row="3" />
    </Grid>
</UserControl>
