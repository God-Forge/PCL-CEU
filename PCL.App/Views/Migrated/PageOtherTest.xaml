<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL.App.Controls"
    mc:Ignorable="d" x:Class="PCL.App.Views.Migrated.PageOtherTest"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15,0,0" Title="今日人品">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock Text="使用当天的 Unix 时间戳作为随机种子，生成 0~100 的人品值。每天的结果固定；低于 10 时弹窗会变为红色警告。"
                               TextWrapping="Wrap" LineHeight="18" />
                    <local:MyButton x:Name="BtnJrrp" Text="测测今日人品" MinWidth="170" Height="35" ColorType="Highlight" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,15,0,0" Title="内存优化">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock x:Name="LabMemoryStatus" Text="当前可用物理内存：读取中……" TextWrapping="Wrap" LineHeight="18" />
                    <TextBlock Text="对应 RAMMap 的 Empty 功能：清空工作集、系统工作集、已修改页列表、待机列表等。清空工作集/待机列表可能让其他程序短暂变慢；系统级操作需要管理员权限。"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnMemoryQuick" Text="一键优化" Tag="Quick" MinWidth="140" Height="35" ColorType="Highlight" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMemoryDeep" Text="深度清理（含待机列表）" Tag="Deep" MinWidth="200" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMemoryCurrent" Text="清理 PCL 内存" Tag="CurrentProcess" MinWidth="140" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMemoryWorkingSet" Text="清空工作集" Tag="WorkingSets" MinWidth="140" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMemorySystemWorkingSet" Text="清空系统工作集" Tag="SystemWorkingSet" MinWidth="160" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMemoryModified" Text="清空已修改页列表" Tag="ModifiedPageList" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMemoryStandby" Text="清空待机列表" Tag="StandbyList" MinWidth="140" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMemoryPriority0" Text="清空优先级 0 待机列表" Tag="Priority0StandbyList" MinWidth="200" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMemoryRefresh" Text="刷新状态" MinWidth="120" Height="35" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock x:Name="LabMemoryAdmin" Text="当前权限：读取中……" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.75" />
                    <local:MyButton x:Name="BtnMemoryAdmin" Text="以管理员身份执行完整优化" MinWidth="240" Height="35" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,15,0,15" Title="MCA Selector 区块编辑器">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock Text="MCA Selector 2.9 可以查看、删除、导入和导出 Minecraft 世界区块。它由 Querz 开发，以 MIT 许可证分发。"
                               TextWrapping="Wrap" LineHeight="18" />
                    <TextBlock Text="首次启动会从 PCL 内置资源中解压约 56 MB 的 MCA Selector 与 Java 运行时，之后会直接启动，无需重复解压。"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0" />
                    <TextBlock Text="注意：MCA Selector 会直接修改世界存档，操作前请先备份存档。"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0" Foreground="{DynamicResource ColorBrush3}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <local:MyButton x:Name="BtnLaunch" Text="启动 MCA Selector" MinWidth="170" Height="35" ColorType="Highlight" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnSaves" Text="打开当前实例存档文件夹" MinWidth="190" Height="35" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnChooseWorld" Text="选择世界文件夹..." MinWidth="170" Height="35" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnHome" Text="MCA Selector 项目主页" MinWidth="190" Height="35" />
                    </StackPanel>
                    <TextBlock Text="MCA Selector 2.9 © 2018-2026 Querz，MIT License。项目地址：https://github.com/Querz/mcaselector"
                               TextWrapping="Wrap" Margin="0,16,0,0" Opacity="0.7" FontSize="12" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="Payload 版本包">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock Text="将当前选中的 Minecraft 版本打包为 .payload（带有 128 字节特殊头部的 zip），或把 .payload 解包到指定文件夹。"
                               TextWrapping="Wrap" LineHeight="18" />
                    <TextBlock Text="C++ 编解码工具会在首次使用时释放到 ./runtime/encode.exe 与 ./runtime/decode.exe。"
                               TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnPayloadEncode" Text="打包当前版本" MinWidth="170" Height="35" ColorType="Highlight" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnPayloadDecode" Text="解包 Payload" MinWidth="170" Height="35" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnPayloadImport" Text="导入 Payload" MinWidth="170" Height="35" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,15,0,15" Title="世界备份">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock Text="备份当前实例的 saves 文件夹；启动 MCA Selector 前也会自动创建一次备份，并保留最近 10 份。"
                               TextWrapping="Wrap" LineHeight="18" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnWorldBackup" Text="备份当前存档" MinWidth="170" Height="35" ColorType="Highlight" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnWorldRestore" Text="恢复最近备份" MinWidth="170" Height="35" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnWorldBackupOpen" Text="打开备份目录" MinWidth="170" Height="35" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="实例体检">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock Text="检查版本 JSON、客户端 JAR、libraries、assets 与 Mod 依赖；修复基础文件会重新下载缺失的原版文件。"
                               TextWrapping="Wrap" LineHeight="18" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnInstanceCheck" Text="检查当前实例" MinWidth="170" Height="35" ColorType="Highlight" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnInstanceRepair" Text="修复基础文件" MinWidth="170" Height="35" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnModsCheck" Text="检查 Mod" MinWidth="170" Height="35" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="实例高级工具">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock Text="诊断包会收集实例日志、崩溃报告、Mod 列表与系统信息，并自动脱敏访问令牌和用户路径。"
                               TextWrapping="Wrap" LineHeight="18" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnCrashDiagnostic" Text="导出崩溃诊断包" MinWidth="170" Height="35" ColorType="Highlight" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnCloneInstance" Text="克隆当前实例" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnSnapshot" Text="创建实例快照" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnSnapshotRestore" Text="恢复最近快照" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnResourceScan" Text="扫描资源包/光影" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnResourceToggle" Text="启用/禁用资源包" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnResourceOpen" Text="打开资源包/光影目录" MinWidth="190" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnSpeedTest" Text="测试下载源" MinWidth="150" Height="35" Margin="0,0,10,10" />                        <local:MyButton x:Name="BtnCrashHistory" Text="崩溃历史" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnCrashAnalyze" Text="分析崩溃日志" MinWidth="150" Height="35" ColorType="Highlight" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnImportModpack" Text="导入整合包" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnLogViewer" Text="查看最新日志" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnDiagnosticShare" Text="复制诊断摘要" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnExportLaunchConfig" Text="导出启动配置" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnImportLaunchConfig" Text="导入启动配置" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnLaunchTiming" Text="查看启动耗时" MinWidth="170" Height="35" Margin="0,0,10,10" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="高级维护与诊断">
                <StackPanel Margin="21,40,21,16">
                    <WrapPanel>
                        <local:MyButton x:Name="BtnAdvancedAudit" Text="运行高级体检" MinWidth="150" Height="35" ColorType="Highlight" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnOfflinePack" Text="导出离线整合包" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnMigrate" Text="迁移实例" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnWorldManage" Text="查看存档列表" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnWorldBackupSelected" Text="备份选中存档" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnWorldRestoreSelected" Text="恢复选中存档" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnModAutoFix" Text="自动修复 Mod" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnModConfig" Text="打开 Mod 配置目录" MinWidth="180" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnResourceBackup" Text="备份资源包/光影" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnResourceRestore" Text="恢复资源包/光影" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnCrashCompare" Text="对比崩溃报告" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnEnvironment" Text="环境诊断" MinWidth="150" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnJvmLow" Text="JVM 低配" MinWidth="130" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnJvmBalanced" Text="JVM 均衡" MinWidth="130" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnJvmHigh" Text="JVM 高性能" MinWidth="140" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnProcessMonitor" Text="游戏资源监控" MinWidth="170" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnSourceHistory" Text="下载源历史/自动选择" MinWidth="210" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnLiveLog" Text="开始实时日志" MinWidth="160" Height="35" Margin="0,0,10,10" />
                        <local:MyButton x:Name="BtnLiveLogStop" Text="停止实时日志" MinWidth="160" Height="35" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBox x:Name="TxtLiveLog" Height="160" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" />
                </StackPanel>
            </local:MyCard>            <local:MyCard Margin="0,15,0,15" Title="Java 打包">
                <StackPanel Margin="21,40,21,16">
                    <TextBlock Text="选择电脑上的 java.exe，自动识别 JDK/JRE 与版本，打包为 &lt;版本&gt;.jdk.javapkg 或 &lt;版本&gt;.jre.javapkg。导入时会解压并加入 Java 列表。"
                               TextWrapping="Wrap" LineHeight="18" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnJavaPack" Text="打包 Java" MinWidth="170" Height="35" ColorType="Highlight" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnJavaPackImport" Text="导入 Java 包" MinWidth="170" Height="35" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnJavaPackOpen" Text="打开 Java 包目录" MinWidth="170" Height="35" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>










