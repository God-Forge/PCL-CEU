<UserControl x:Class="PCL.App.Views.PageCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="迁移页面" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
            <ListBox x:Name="PageList" SelectionChanged="PageList_SelectionChanged" />
        </DockPanel>
        <Border Grid.Column="1" Margin="18,0,0,0" Background="White" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <ContentControl x:Name="PageHost" />
                <TextBlock x:Name="ErrorText" Margin="20" Foreground="#C33" TextWrapping="Wrap" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
