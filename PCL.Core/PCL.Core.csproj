<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <OutputType>Library</OutputType>
        <UseWPF>true</UseWPF>
        <OutDir>bin\</OutDir>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <Configurations>Debug;Release;Snapshot</Configurations>
        <Deterministic>true</Deterministic>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Diagnostics.CodeAnalysis" />
        <Using Include="System.Collections" />
        <Using Include="System.Collections.Generic" />
        <Using Include="System.Collections.ObjectModel" />
        <Using Include="System.Linq" />
        <Using Include="System.IO" />
        <Using Include="System.Text" />
        <Using Include="System.Text.RegularExpressions" />
        <Using Include="MeloongCore" />
        <Using Include="MeloongCore.Extensions" />
    </ItemGroup>

    <ItemGroup>
        <!-- 原先引用 ..\Plain Craft Launcher 2\Resources\，使 C# 构建依赖 VB 工程目录；
             现改为项目内自带资源，VB 工程可独立移除。 -->
        <EmbeddedResource Include="Assets\McASelector.zip" LogicalName="PCL.Resources.McASelector.zip" />
        <EmbeddedResource Include="Assets\Payload\encode.exe" LogicalName="PCL.Resources.Payload.encode.exe" />
        <EmbeddedResource Include="Assets\Payload\decode.exe" LogicalName="PCL.Resources.Payload.decode.exe" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\MeloongCore\Shared\MeloongCore.csproj" />
        <ProjectReference Include="..\PCLCS\PCLCS.csproj" />
        <ProjectReference Include="..\PCL.Core.Net\PCL.Core.Net.csproj" />
        <ProjectReference Include="..\PCL.Core.Infrastructure\PCL.Core.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Net\**\*.cs" />
        <Compile Remove="Download\**\*.cs" />
        <Compile Remove="Update\**\*.cs" />
        <Compile Remove="Settings\**\*.cs" />
        <Compile Remove="Paths\**\*.cs" />
        <Compile Remove="IO\**\*.cs" />
        <Compile Remove="Localization\**\*.cs" />
        <Compile Remove="Native\**\*.cs" />
        <Compile Remove="Tasks\**\*.cs" />
        <Compile Remove="Validation\**\*.cs" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DefineConstants>$(DefineConstants);SNAPSHOT</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Snapshot|AnyCPU'">
        <Optimize>True</Optimize>
    </PropertyGroup>

</Project>




